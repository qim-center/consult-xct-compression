// Colors, see: https://qim.dk/identity/
#let orange = rgb(252, 115, 35)  // QIM Orange
#let red = rgb(230, 63, 71) // QIM Red
#let grey = rgb(116, 116, 116) // QIM Grey
#let background = rgb(248, 249, 250) // QIM Background

// Design system tokens, see: https://claude.ai/artifact/VhmYJvNneXR3zAJ7A4YJYX
#let ink = rgb("#5c5c5c") // Headings and body text
#let ink-muted = grey // Secondary text, labels
#let surface-raised = rgb("#ffffff") // Cards and panels on background
#let hairline = rgb("#d1d1d1") // Decorative 1px rules

// Name
#let name = "Qim"
#let name-long = "Center for Quantification of Imaging Data from MAX IV"
#let name-short = "Qim Center"

// Logo path
#let logo = path("assets/qim_logo.svg")
