flowchart LR

    subgraph Remote["Networked storage · <i>S3 or HTTPS</i>"]
        Data[("📂 <code>vol.ome.zarr</code>")]
    end

    Download["<code><b>ome_zarr download</b> server/vol.ome.zarr</code>"]
    Export["<code><b>ome_zarr export</b> server/vol.ome.zarr --format tiff-stack</code>"]

    subgraph Local["Local disk"]
        DataLocal[("📂 <code>vol.ome.zarr</code>")]
        TIFF["📂 <code>vol/</code>
        <code>slice_z0000.tiff</code>
        <code>slice_z0001.tiff</code>
        <code>…</code>"]
    end

    subgraph Native["OME-Zarr-aware tools"]
        QVE(["Qim Volume Explorer"])
        InSegt(["InSegt3D"])
    end

    Legacy(["Legacy viewers / software"])

    Data -. "stream" .-> Native
    Data --> Download --> DataLocal --> Native
    Data -- "compressed transfer,<br>selected slices / resolution" --> Export --> TIFF --> Legacy
