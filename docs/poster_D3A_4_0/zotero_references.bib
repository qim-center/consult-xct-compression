@article{ref:manciniMethodCompressingXray2018a,
  title = {About a Method for Compressing X-Ray Computed Microtomography Data},
  author = {Mancini, Lucia and Kourousias, George and Billè, Fulvio and De Carlo, Francesco and Fidler, Aleš},
  date = {2018-04-01},
  journaltitle = {Measurement Science and Technology},
  shortjournal = {Meas. Sci. Technol.},
